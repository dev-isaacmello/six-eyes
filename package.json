{
  "name": "@dev-isaacmello/six-eyes",
  "version": "1.2.2",
  "description": "Runtime-aware cognitive constraint shaping for AI coding agents",
  "type": "module",
  "bin": {
    "six-eyes": "./bin/six-eyes.js"
  },
  "scripts": {
    "start": "node bin/six-eyes.js",
    "dev": "node bin/six-eyes.js review",
    "init": "node bin/six-eyes.js init --provider claude",
    "install:skill": "node install.js --provider claude",
    "scan": "node bin/six-eyes.js scan",
    "graph": "node bin/six-eyes.js graph",
    "review": "node bin/six-eyes.js review",
    "context": "node bin/six-eyes.js context",
    "enforce": "node bin/six-eyes.js enforce",
    "maps": "node bin/six-eyes.js maps",
    "protocols": "node bin/six-eyes.js protocols",
    "skills": "node bin/six-eyes.js skills",
    "test": "node --test \"tests/**/*.test.js\"",
    "publish:npm": "npm publish --access public"
  },
  "files": [
    "assets",
    "bin",
    "contracts",
    "core",
    "docs",
    "examples",
    "providers",
    "protocols",
    "skills",
    "templates",
    "AI.md",
    "ARCHITECTURE.md",
    "BOUNDARIES.md",
    "install.js",
    "README.md",
    "LICENSE",
    "sixeyes.manifest.json",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "exports": {
    ".": "./install.js",
    "./core/*": "./core/*.js",
    "./core/scanner/*": "./core/scanner/*.js",
    "./core/semantic-engine/*": "./core/semantic-engine/*.js",
    "./core/dependency-engine/*": "./core/dependency-engine/*.js",
    "./core/context-engine/*": "./core/context-engine/*.js",
    "./core/enforce-engine/*": "./core/enforce-engine/*.js",
    "./core/memory-engine/*": "./core/memory-engine/*.js",
    "./core/snapshot-engine/*": "./core/snapshot-engine/*.js",
    "./core/protocol-engine/*": "./core/protocol-engine/*.js",
    "./core/provider-runtime/*": "./core/provider-runtime/*.js",
    "./core/shared/*": "./core/shared/*.js"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "openai",
    "codex",
    "langgraph",
    "langchain",
    "ai-agents",
    "architecture",
    "cognition",
    "cognitive-constraint-shaping",
    "software-engineering",
    "llm",
    "code-analysis"
  ],
  "author": "Isaac Mello | Full Stack Software Engineer",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0"
  }
}
